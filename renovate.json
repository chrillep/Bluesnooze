{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the SwiftLint version",
      "managerFilePatterns": ["/(^|/)\\.swiftlint-version$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+(?<currentValue>[^\\s#]+)"
      ]
    }
  ]
}
