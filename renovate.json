{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    ":preserveSemverRanges"
  ],
  "forkProcessing": "enabled",
  "timezone": "Europe/Stockholm",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the SwiftLint version",
      "managerFilePatterns": ["/(^|/)\\.swiftlint-version$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+(?<currentValue>[^\\s#]+)"
      ]
    }
  ]
}
