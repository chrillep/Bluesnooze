{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    ":preserveSemverRanges",
    ":automergeMinor"
  ],
  "forkProcessing": "enabled",
  "platformAutomerge": false,
  "minimumReleaseAge": "14 days",
  "labels": ["dependencies"],
  "timezone": "Europe/Stockholm",
  "packageRules": [
    {
      "matchManagers": ["cocoapods", "swift"],
      "addLabels": ["swift"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"]
    },
    {
      "matchPackageNames": ["realm/SwiftLint"],
      "addLabels": ["swift"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the SwiftLint version",
      "managerFilePatterns": ["/(^|/)\\.swiftlint-version$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+(?<currentValue>[^\\s#]+)"
      ]
    }
  ]
}
